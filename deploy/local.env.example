# Copy this file to .env if you want to override the local Docker defaults:
# cp deploy/local.env.example .env

FRONTEND_PORT=8088
BACKEND_PORT=8080
RECOMMEND_PORT=8000

MYSQL_PORT=3306
MYSQL_ROOT_PASSWORD=root123
DB_NAME=course_db
DB_USERNAME=dev
DB_PASSWORD=dev123

REDIS_PORT=6379
REDIS_PASSWORD=redis123

NEO4J_HTTP_PORT=7474
NEO4J_BOLT_PORT=7687
NEO4J_PASSWORD=neo4j123

APP_BASE_URL=http://localhost:8088
CORS_ALLOWED_ORIGIN_PATTERNS=http://localhost:8088,http://127.0.0.1:8088
APP_TZ=Asia/Shanghai

# Host directory mounted into backend container as /app/videos.
# Keep this directory structure aligned with video paths stored in MySQL.
VIDEO_HOST_DIR=/home/shiyang/code_space/course_videos

# Local Docker deployment defaults to mock agent answers.
# Set these if you want to connect a real OpenAI-compatible model service.
AGENT_LLM_PROVIDER=mock
AGENT_LLM_API_KEY=

# Keep Java LocalDateTime.now() aligned with MySQL TZ.
JAVA_TOOL_OPTIONS=-Duser.timezone=Asia/Shanghai

# Optional JVM tuning, for example: -Xms512m -Xmx1g
JAVA_OPTS=
